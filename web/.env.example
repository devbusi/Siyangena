# Backend API (Render URL in production)
VITE_API_URL=http://localhost:4000/api
# Supabase: Project URL and the publishable key (safe in the browser)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Same as the backend's XRPL_NETWORK: testnet or devnet
VITE_XRPL_NETWORK=testnet
# Same as the backend's SETTLE_ASSET (leave empty for RLUSD)
VITE_SETTLE_ASSET=
# Preview with simulated data, no backend: VITE_MOCK=1
