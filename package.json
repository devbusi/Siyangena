{
  "name": "siyangena",
  "version": "0.1.0",
  "private": true,
  "description": "Siyangena: AI agents that get fans real tickets, on a ledger that makes scalping and ticket scams impossible.",
  "workspaces": [
    "shared",
    "backend",
    "agent"
  ],
  "scripts": {
    "dev": "npm run dev -w backend",
    "start": "npm run start -w backend",
    "typecheck": "npm run typecheck -w shared && npm run typecheck -w backend && npm run typecheck -w agent",
    "preflight": "tsx scripts/preflight.ts",
    "setup": "tsx scripts/setup.ts",
    "demo": "tsx scripts/demo.ts",
    "agent": "npm run start -w agent --",
    "mcp": "npm run mcp -w agent"
  },
  "devDependencies": {
    "@drop/shared": "*",
    "@types/node": "^24.5.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "xrpl": "^5.3.0",
    "dotenv": "^17.3.1"
  }
}
