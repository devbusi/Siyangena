{
  "name": "siyangena",
  "version": "0.1.0",
  "private": true,
  "description": "Siyangena: real event tickets, bought directly or by an AI agent within your limits, on a ledger that makes scalping and ticket scams impossible.",
  "workspaces": [
    "shared",
    "backend",
    "agent",
    "web"
  ],
  "scripts": {
    "dev": "npm run dev -w backend",
    "start": "npm run start -w backend",
    "typecheck": "npm run typecheck -w shared && npm run typecheck -w backend && npm run typecheck -w agent && npm run typecheck -w web",
    "preflight": "tsx scripts/preflight.ts",
    "setup": "tsx scripts/setup.ts",
    "bank": "tsx scripts/bank.ts",
    "test-accounts": "tsx scripts/test-accounts.ts",
    "test-flow": "tsx scripts/test-accounts.ts --flow",
    "test-clean": "tsx scripts/test-accounts.ts --clean",
    "demo": "tsx scripts/demo.ts",
    "agent": "npm run start -w agent --",
    "mcp": "npm run mcp -w agent",
    "web": "npm run dev -w web"
  },
  "devDependencies": {
    "@drop/shared": "*",
    "@types/node": "^24.5.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "xrpl": "^5.3.0",
    "dotenv": "^17.3.1"
  },
  "engines": {
    "node": ">=20"
  }
}
