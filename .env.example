# Server
PORT_NUMBER=4000

# Shared secret for human-only routes (promoter + mandate writes).
# The web app sends it as "Authorization: Bearer <key>"; agent processes never get it.
# Leave empty in local dev to disable the check.
HUMAN_API_KEY=

# XRPL network: "testnet" (RLUSD) or "devnet" (XRP). See shared/src/config.ts.
XRPL_NETWORK=
XRPL_WSS=
RLUSD_ISSUER=
FX_ZAR_PER_RLUSD=

# Demo cast (Testnet/Devnet seeds only, written by scripts/setup.ts)
PROMOTER_SEED=
BANK_SEED=
THANDI_SEED=
THANDI_AGENT_SEED=
SIPHO_SEED=
SIPHO_AGENT_SEED=
SCALPER_AGENT_SEED=
SCAMMER_SEED=
ISSUANCE_ID=

ANTHROPIC_API_KEY=
BACKEND_URL=http://localhost:4000
AGENT_MODEL=claude-sonnet-5-5
