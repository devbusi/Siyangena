# ---------- Backend server ----------
PORT_NUMBER=4000

# Admin key for the setup and demo scripts ("Authorization: Bearer <key>").
# Make one: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
HUMAN_API_KEY=

# ---------- Accounts (Supabase) ----------
# Project Settings > Data API for the URL, Project Settings > API Keys for the secret key.
# The secret key bypasses RLS: it lives only here and in Render, never in the web app.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Encrypts every account's wallet seed. 64 hex characters. Make one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never change it after people sign up, or their wallets can't be opened.
WALLET_ENCRYPTION_KEY=
# The web app's address(es), comma-separated, for CORS. Empty allows any origin.
CORS_ORIGIN=
# Set to "off" to stop the demo cast (thandi, sipho, scalper) being usable without signing in.
DEMO_CAST=

# ---------- SMS (placeholder) ----------
# Ticket texts are printed to the backend log for the MVP. The web app's address, for links in them:
APP_URL=

# ---------- XRPL ----------
# "testnet" settles in RLUSD (needs RLUSD in BANK for top-ups), "devnet" settles in XRP
# (new accounts are funded by the faucet, so they can buy straight away).
XRPL_NETWORK=
XRPL_WSS=
RLUSD_ISSUER=
FX_ZAR_PER_RLUSD=
# Set to XRP to pay in test XRP on Testnet (when the RLUSD faucet is not paying out). Rand per XRP below.
SETTLE_ASSET=
FX_ZAR_PER_XRP=
# Siyangena's commission on promoters' earnings, taken before payout (default 5)
PLATFORM_FEE_PCT=

# Platform and demo wallets (Testnet/Devnet seeds only, written by `npm run setup`)
PROMOTER_SEED=
BANK_SEED=
THANDI_SEED=
THANDI_AGENT_SEED=
SIPHO_SEED=
SIPHO_AGENT_SEED=
SCALPER_AGENT_SEED=
SCAMMER_SEED=
ISSUANCE_ID=

# ---------- Agent ----------
ANTHROPIC_API_KEY=
BACKEND_URL=http://localhost:4000
AGENT_MODEL=claude-sonnet-5-5
